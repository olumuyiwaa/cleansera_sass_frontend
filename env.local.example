# ═══════════════════════════════════════════════════════════════
# .env.local  —  Local development only
# DO NOT commit this file. It is already in .gitignore.
# ═══════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CleanSera Business Dashboard"
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=development

# ─── Backend API (cleansera_sass) ───────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT=15000

# ─── WebSocket (Socket.io — dispatch/messaging live updates) ────
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_SOCKET_RECONNECT_DELAY=3000

# ─── Auth ───────────────────────────────────────────────────────
NEXT_PUBLIC_TOKEN_EXPIRES_IN=15m
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRES_IN=30d

# ─── File storage (DigitalOcean Spaces — job photos, docs) ──────
NEXT_PUBLIC_DO_SPACES_CDN=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
NEXT_PUBLIC_SIGNED_URL_EXPIRY=300

# ─── Google Maps (service-area geofencing, address autocomplete) ─
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxx
NEXT_PUBLIC_MAP_DEFAULT_LAT=6.5244
NEXT_PUBLIC_MAP_DEFAULT_LNG=3.3792
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# ─── Stripe (CleanSera subscription billing only) ───────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ─── Feature Flags ──────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_SUBSCRIPTION=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_2FA=true
NEXT_PUBLIC_FEATURE_SMS_NOTIFICATIONS=true

# ─── Pagination ─────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# ─── Uploads (job photos, cleaner documents) ────────────────────
NEXT_PUBLIC_MAX_PHOTO_UPLOAD_MB=15
NEXT_PUBLIC_MAX_AVATAR_UPLOAD_MB=5
NEXT_PUBLIC_MAX_ATTACHMENT_UPLOAD_MB=25

# ─── Support ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@cleansera.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://cleansera.com/privacy
NEXT_PUBLIC_TERMS_URL=https://cleansera.com/terms
